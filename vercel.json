{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/dashboard/stats", "destination": "/api/stats.ts" },
    { "source": "/api/stripe/create-checkout-session", "destination": "/api/create-checkout-session.ts" },
    { "source": "/api/stripe/webhook", "destination": "/api/stripe-webhook.ts" },
    { "source": "/api/ai/brief", "destination": "/api/ai-brief.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
