# =============================================================================
# ClubRM environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- Supabase (REQUIRED) ------------------------------------------------------
# Find these in your Supabase project settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Public site URL (used by Stripe success/cancel redirects) ----------------
VITE_SITE_URL=http://localhost:5173

# --- Google Gemini AI brief (server-side only) --------------------------------
# Set GEMINI_API_KEY (preferred) so the key never leaves the server.
# VITE_GEMINI_API_KEY is supported as a fallback but exposes the key in the
# client bundle — only use it for local development.
GEMINI_API_KEY=

# --- Stripe (server-side only) ------------------------------------------------
# Used by /api/stripe/create-checkout-session.
STRIPE_SECRET_KEY=

# --- Vercel auto-populated values (do not set manually) -----------------------
# VERCEL_URL is populated automatically on Vercel deployments.
